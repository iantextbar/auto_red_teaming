# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Derived data: every file in data/ is regenerated by the scripts (D17)
data/*
!data/.gitkeep

# PDFs are shared outside git (D14)
references/pdfs/**/*.pdf

# Obsidian per-user state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# LaTeX build artifacts do paper/ (o PDF final fica versionado para revisão)
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.txt
paper/figs/*.aux
paper/figs/*.log
